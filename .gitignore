# Dependencies and build output
/node_modules/
/dist/
/target/
/src-tauri/target/
/src-tauri/binaries/
/src-tauri/gen/
# Generated by tauri-build from the app manifest command list.
/src-tauri/permissions/autogenerated/
# Icon generator also emits mobile assets; Rhythm targets desktop only.
/src-tauri/icons/android/
/src-tauri/icons/ios/

# Local environment and OS/editor files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Local models and runtime data (never commit personal data or weights)
*.gguf
*.safetensors
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Local Claude Code skills, agents and worktrees (Impeccable install); only the
# shared project settings are committed.
/.claude/*
!/.claude/settings.json

# Impeccable review screenshots (regenerated per design review)
/.impeccable/review/

# Python bytecode (collector meal-ocr tests)
__pycache__/
