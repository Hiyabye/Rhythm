*.log

# Local models and runtime data (never commit personal data or weights)
*.gguf
*.safetensors
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Local Claude Code skills, agents and hooks (Impeccable install)
/.claude/

# Impeccable review screenshots (regenerated per design review)
/.impeccable/review/
