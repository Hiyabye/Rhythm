{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm run test:desktop)",
      "Bash(npm run test:release)",
      "Bash(npm run test:ui)",
      "Bash(npm run test:ui *)",
      "Bash(npx playwright test *)",
      "Bash(node --test *)",
      "Bash(node scripts/stage-llama.mjs)",
      "Bash(cargo fmt *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)"
    ],
    "ask": [
      "Bash(cargo test * --ignored*)",
      "Bash(cargo test * --include-ignored*)",
      "Bash(cargo run -p rhythm-collector*)",
      "Bash(cargo run --release -p rhythm-collector*)",
      "Bash(gh release *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(npm run deploy*)",
      "Bash(npx wrangler deploy)",
      "Bash(npx wrangler deploy --name *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-setup.sh --claude-hook",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
