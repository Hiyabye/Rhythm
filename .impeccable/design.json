  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled accent action, 28px high.",
      "html": "<button class=\"ds-button\">설정에서 시작하기</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:28px;padding:5px 14px;border:1px solid var(--accent-fill,#0a62d0);background:var(--accent-fill,#0a62d0);color:var(--accent-text,#fff);border-radius:6px;font:500 13px/1.5 \"Pretendard Variable\",-apple-system,sans-serif;cursor:pointer;transition:background .15s,color .15s,border-color .15s}.ds-button:hover{filter:brightness(1.1)}.ds-button:focus-visible{outline:2px solid var(--accent,#0a62d0);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Neutral outlined action.",
      "html": "<button class=\"ds-button-secondary\">나중에</button>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;min-height:28px;padding:5px 14px;border:1px solid var(--line-strong,#cfcfd4);background:var(--surface,#fff);color:var(--text,#1d1d1f);border-radius:6px;font:500 13px/1.5 \"Pretendard Variable\",-apple-system,sans-serif;cursor:pointer;transition:background .15s}.ds-button-secondary:hover{background:var(--hover,rgb(0 0 0/.045))}.ds-button-secondary:focus-visible{outline:2px solid var(--accent,#0a62d0);outline-offset:2px}"
    },
    {
      "name": "Source List",
      "kind": "nav",
      "refersTo": "source-item",
      "description": "Sidebar primary items with count badge, group heading, organization sub-label and board rows with family swatch.",
      "html": "<nav class=\"ds-sidebar\"><button class=\"ds-item ds-active\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg><span class=\"ds-label\">오늘</span></button><button class=\"ds-item\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M4 4h16v16H4z\"/><path d=\"M4 14h4l2 3h4l2-3h4\"/></svg><span class=\"ds-label\">받은 소식</span><span class=\"ds-count\">12</span></button><p class=\"ds-group\">서강대학교 공지</p><p class=\"ds-org\">소프트웨어융합대학</p><button class=\"ds-item ds-board\"><span class=\"ds-swatch\"></span><span class=\"ds-label\">소식</span></button></nav>",
      "css": ".ds-sidebar{width:232px;padding:18px 10px 12px;background:var(--sidebar,#f0f0f2);border-right:1px solid var(--line,#e4e4e7);display:grid;gap:1px;font-family:\"Pretendard Variable\",-apple-system,sans-serif}.ds-item{display:flex;align-items:center;gap:9px;width:100%;min-height:30px;padding:5px 10px;border:0;border-radius:6px;background:transparent;color:var(--text,#1d1d1f);font-size:13px;text-align:left;cursor:pointer;transition:background .15s}.ds-item svg{color:var(--accent,#0a62d0);flex-shrink:0}.ds-item:hover{background:var(--hover,rgb(0 0 0/.045))}.ds-item:focus-visible{outline:2px solid var(--accent,#0a62d0);outline-offset:2px}.ds-active{background:var(--soft,#e3edfb);font-weight:600}.ds-label{flex:1}.ds-count{font-size:12px;color:var(--secondary,#5c5c61);font-variant-numeric:tabular-nums}.ds-group{margin:18px 10px 4px;font-size:11px;font-weight:600;color:var(--secondary,#5c5c61)}.ds-org{margin:0;padding:6px 10px 1px 20px;font-size:11px;color:var(--muted,#68686d)}.ds-board{padding-left:20px}.ds-swatch{width:8px;height:8px;margin:0 4px;border-radius:2px;background:var(--family-computing,#d9730d)}"
    },
    {
      "name": "Feedback Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Recommendation feedback toggle; pressed state uses the selection tint.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">관심 있어요</button><button class=\"ds-chip\" aria-pressed=\"false\">관심 없어요</button></div>",
      "css": ".ds-chips{display:flex;gap:6px}.ds-chip{height:26px;padding:0 9px;border:0;border-radius:6px;background:transparent;font:12px \"Pretendard Variable\",-apple-system,sans-serif;color:var(--secondary,#5c5c61);cursor:pointer;transition:opacity .14s,background .14s,color .14s}.ds-chip:hover{background:var(--hover,rgb(0 0 0/.045))}.ds-chip:focus-visible{outline:2px solid var(--accent,#0a62d0);outline-offset:2px}.ds-chip[aria-pressed=true]{background:var(--soft,#e3edfb);color:var(--accent,#0a62d0);font-weight:600}"
    },
    {
      "name": "Pick Row",
      "kind": "custom",
      "description": "One-line Today recommendation row: unread dot, truncated title, trailing family swatch, source and short date; feedback chips replace the meta on hover or focus.",
      "html": "<ul class=\"ds-picks\"><li><button class=\"ds-pick\"><span class=\"ds-title\"><span class=\"ds-dot\"></span><strong>장학금 신청 안내</strong></span><span class=\"ds-meta\"><span class=\"ds-sw\"></span><span>소프트웨어융합대학 소식</span><span>10월 24일</span></span></button></li></ul>",
      "css": ".ds-picks{list-style:none;margin:0;padding:0;font-family:\"Pretendard Variable\",-apple-system,sans-serif}.ds-picks li{border-bottom:1px solid var(--line,#e4e4e7)}.ds-pick{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:12px;width:100%;margin:2px 0;padding:6px 10px 6px 20px;border:0;border-radius:6px;background:transparent;text-align:left;color:var(--text,#1d1d1f);cursor:pointer}.ds-pick:hover{background:var(--hover,rgb(0 0 0/.045))}.ds-pick:focus-visible{outline:2px solid var(--accent,#0a62d0);outline-offset:2px}.ds-title{position:relative;min-width:0;font-size:14px;line-height:1.45;white-space:nowrap}.ds-title strong{display:block;overflow:hidden;text-overflow:ellipsis;font-weight:650}.ds-dot{position:absolute;left:-12px;top:.55em;width:7px;height:7px;border-radius:50%;background:var(--accent,#0a62d0)}.ds-meta{display:flex;align-items:center;justify-content:flex-end;gap:6px;min-width:172px;font-size:12px;color:var(--secondary,#5c5c61);font-variant-numeric:tabular-nums;white-space:nowrap}.ds-sw{width:8px;height:8px;border-radius:2px;background:var(--family-computing,#d9730d)}"
    },
    {
      "name": "Week Day",
      "kind": "custom",
      "refersTo": "day-number-today",
      "description": "Week pane day row: weekday, circled today number, events with family bar or dotted AI bar.",
      "html": "<ol class=\"ds-week\"><li class=\"ds-day ds-today\"><span class=\"ds-dl\"><span class=\"ds-dn\">일</span><span class=\"ds-num\">25</span></span><ul class=\"ds-events\"><li><button class=\"ds-event\"><span class=\"ds-bar\"></span><span class=\"ds-et\">한국어 공지 01</span><span class=\"ds-em\">소프트웨어융합대학 소식</span></button></li><li><button class=\"ds-event ds-ai\"><span class=\"ds-bar\"></span><span class=\"ds-et\"><span class=\"ds-mark\">AI 참고 일정</span> 신청 마감</span><span class=\"ds-em\">원문 확인</span></button></li></ul></li></ol>",
      "css": ".ds-week{list-style:none;margin:0;padding:0;width:300px;font-family:\"Pretendard Variable\",-apple-system,sans-serif}.ds-day{display:grid;grid-template-columns:58px minmax(0,1fr);gap:6px;padding:6px 0}.ds-dl{display:flex;align-items:center;gap:4px;height:30px}.ds-dn{font-size:11px;font-weight:600;color:var(--secondary,#5c5c61)}.ds-today .ds-dn{color:var(--accent,#0a62d0)}.ds-num{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;font-size:15px;font-weight:600;font-variant-numeric:tabular-nums}.ds-today .ds-num{background:var(--accent-fill,#0a62d0);color:var(--accent-text,#fff)}.ds-events{list-style:none;margin:0;padding:0;display:grid;gap:2px}.ds-event{display:grid;grid-template-columns:3px minmax(0,1fr);gap:1px 8px;width:100%;padding:5px 6px;border:0;border-radius:6px;background:transparent;text-align:left;color:var(--text,#1d1d1f);cursor:pointer}.ds-event:hover{background:var(--hover,rgb(0 0 0/.045))}.ds-event:focus-visible{outline:2px solid var(--accent,#0a62d0);outline-offset:2px}.ds-bar{grid-row:span 2;border-radius:2px;background:var(--family-computing,#d9730d)}.ds-ai .ds-bar{background:repeating-linear-gradient(var(--muted,#68686d) 0 3px,transparent 3px 6px)}.ds-et{font-size:12.5px;font-weight:500;line-height:1.4}.ds-em{font-size:11px;color:var(--secondary,#5c5c61)}.ds-mark{padding:0 4px;border:1px solid var(--line-strong,#cfcfd4);border-radius:4px;font-size:11px;font-weight:600;color:var(--secondary,#5c5c61)}"
    },
    {
      "name": "Banner",
      "kind": "card",
      "refersTo": "banner",
      "description": "Nonblocking shell banner on the pane tint; error variant uses danger text and border.",
      "html": "<div class=\"ds-banner\"><div><strong>로컬 AI를 설정할 수 있습니다</strong><p>모델 없이도 읽기, 검색과 추천을 사용할 수 있습니다.</p></div><button class=\"ds-tb\">로컬 AI 설정하기</button></div>",
      "css": ".ds-banner{display:flex;align-items:flex-start;gap:10px;padding:11px 14px;background:var(--pane,#fafafb);border:1px solid var(--line,#e4e4e7);border-radius:8px;font:13px/1.6 \"Pretendard Variable\",-apple-system,sans-serif;color:var(--text,#1d1d1f)}.ds-banner strong{font-weight:600}.ds-banner p{margin:1px 0 0;color:var(--secondary,#5c5c61)}.ds-tb{margin-left:auto;white-space:nowrap;border:0;background:transparent;padding:2px 4px;color:var(--accent,#0a62d0);font:inherit;cursor:pointer}.ds-tb:hover{text-decoration:underline;text-underline-offset:3px}.ds-tb:focus-visible{outline:2px solid var(--accent,#0a62d0);outline-offset:2px}"
    },
    {
      "name": "Settings Group",
      "kind": "card",
      "refersTo": "settings-group",
      "description": "Grouped rows: title on the left, one control on the right, ⓘ for any explanation.",
      "html": "<div class=\"ds-group\"><div class=\"ds-row\"><span class=\"ds-row-label\">전원 모드<button class=\"ds-hint\" aria-label=\"전원 모드 설명\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 11v6m0-10v.1M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z\"/></svg></button></span><span class=\"ds-seg\"><button class=\"on\" aria-pressed=\"true\">절전</button><button aria-pressed=\"false\">균형</button><button aria-pressed=\"false\">성능</button></span></div><div class=\"ds-row\"><span class=\"ds-row-label\">새 공지 자동 확인</span><button class=\"ds-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"자동 동기화\"><span></span></button></div><div class=\"ds-row\"><span class=\"ds-row-label\">운영체제 알림 권한<span class=\"ds-detail\">아직 결정되지 않음</span></span><button class=\"ds-btn\">권한 요청</button></div></div>",
      "css": ".ds-group{background:var(--pane,#fafafb);border:1px solid var(--line,#e4e4e7);border-radius:10px;font:13px \"Pretendard Variable\",-apple-system,sans-serif;color:var(--text,#1d1d1f)}.ds-row{display:flex;align-items:center;gap:10px;min-height:46px;padding:8px 14px}.ds-row+.ds-row{border-top:1px solid var(--line,#e4e4e7)}.ds-row-label{flex:1;display:flex;flex-wrap:wrap;align-items:center;gap:2px;font-weight:500}.ds-detail{flex-basis:100%;font-size:12px;font-weight:400;color:var(--secondary,#5c5c61)}.ds-hint{display:inline-grid;place-items:center;width:22px;height:22px;border:0;border-radius:50%;background:transparent;color:var(--muted,#68686d);cursor:pointer}.ds-hint:hover,.ds-hint:focus-visible{color:var(--accent,#0a62d0)}.ds-seg{display:flex;gap:2px;padding:2px;border:1px solid var(--line,#e4e4e7);border-radius:7px;background:var(--sidebar,#f0f0f2)}.ds-seg button{min-height:24px;padding:2px 10px;border:0;border-radius:5px;background:transparent;font-size:12px;color:var(--secondary,#5c5c61);cursor:pointer}.ds-seg button.on{background:var(--surface,#fff);color:var(--accent,#0a62d0);box-shadow:0 1px 3px #0000000a}.ds-switch{width:35px;height:21px;padding:3px;border:0;border-radius:20px;background:var(--accent,#0a62d0);display:flex;cursor:pointer}.ds-switch span{width:15px;height:15px;border-radius:50%;background:#fff;box-shadow:0 1px 2px #0002;transform:translateX(14px)}.ds-btn{min-height:24px;padding:3px 10px;border:1px solid var(--line-strong,#cfcfd4);border-radius:6px;background:var(--surface,#fff);font-size:12px;cursor:pointer}.ds-btn:hover{background:var(--hover,rgb(0 0 0/.045))}:is(.ds-hint,.ds-seg button,.ds-switch,.ds-btn):focus-visible{outline:2px solid var(--accent,#0a62d0);outline-offset:2px}"
    },
    {
      "name": "Board Tile",
      "kind": "custom",
      "refersTo": "board-tile",
      "description": "One large subscription switch per board; lit with the accent fill and a check when subscribed.",
      "html": "<ul class=\"ds-tiles\"><li class=\"ds-tile on\"><button role=\"switch\" aria-checked=\"true\" aria-label=\"소프트웨어융합대학 공지사항 구독\"><span class=\"ds-mark\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span><span>공지사항</span></button><button class=\"ds-info\" aria-label=\"소프트웨어융합대학 공지사항 상태\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 11v6m0-10v.1M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z\"/></svg></button></li><li class=\"ds-tile\"><button role=\"switch\" aria-checked=\"false\" aria-label=\"소프트웨어융합대학 장학 구독\"><span class=\"ds-mark\"></span><span>장학</span></button><button class=\"ds-info\" aria-label=\"소프트웨어융합대학 장학 상태\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 11v6m0-10v.1M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z\"/></svg></button></li></ul>",
      "css": ".ds-tiles{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(148px,1fr));gap:8px;font:13px \"Pretendard Variable\",-apple-system,sans-serif}.ds-tile{position:relative}.ds-tile>button[role=switch]{width:100%;min-height:72px;display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;gap:12px;padding:11px 12px;border:1px solid var(--line-strong,#cfcfd4);border-radius:10px;background:var(--surface,#fff);color:var(--text-2,#3a3a3e);font:inherit;font-weight:550;text-align:left;cursor:pointer;transition:background .15s,border-color .15s,color .15s,box-shadow .15s}.ds-tile>button[role=switch]:hover{border-color:var(--secondary,#5c5c61)}.ds-tile.on>button[role=switch]{background:var(--accent-fill,#0a62d0);border-color:var(--accent-fill,#0a62d0);color:var(--accent-text,#fff);box-shadow:0 3px 12px rgb(10 98 208/.28)}.ds-mark{display:grid;place-items:center;width:18px;height:18px;border:1.5px solid var(--line-strong,#cfcfd4);border-radius:50%}.ds-tile.on .ds-mark{background:#fff;border-color:#fff;color:var(--accent-fill,#0a62d0)}.ds-info{position:absolute;top:6px;right:6px;width:26px;height:26px;display:grid;place-items:center;border:0;border-radius:6px;background:transparent;color:var(--muted,#68686d);cursor:pointer}.ds-tile.on .ds-info{color:rgb(255 255 255/.85)}.ds-info:hover{background:var(--hover,rgb(0 0 0/.045))}.ds-tile.on .ds-info:hover{background:rgb(255 255 255/.16)}.ds-tile button:focus-visible{outline:2px solid var(--accent,#0a62d0);outline-offset:2px}"
    },
    {
      "name": "Model Tile",
      "kind": "card",
      "refersTo": "model-tile",
      "description": "Installed models select by clicking the whole tile; the chosen one uses the selection tint and 사용 중.",
      "html": "<div class=\"ds-models\"><div class=\"ds-model sel\"><button class=\"ds-pick\" aria-pressed=\"true\" aria-label=\"Qwen3.5 4B 선택\"></button><div class=\"ds-mh\"><strong>Qwen3.5 4B</strong><span class=\"ds-using\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg>사용 중</span></div><span class=\"ds-meta\">균형 잡힌 공지 분석 · 2614.0 MB</span></div><div class=\"ds-model\"><div class=\"ds-mh\"><strong>Qwen3.5 2B</strong></div><span class=\"ds-meta\">가벼운 공지 분석 · 1221.5 MB</span><button class=\"ds-install\" aria-label=\"Qwen3.5 2B 다운로드 및 설치\">설치</button></div></div>",
      "css": ".ds-models{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;font:13px \"Pretendard Variable\",-apple-system,sans-serif;color:var(--text,#1d1d1f)}.ds-model{position:relative;display:flex;flex-direction:column;gap:3px;min-height:112px;padding:12px 12px 10px 14px;border:1px solid var(--line-strong,#cfcfd4);border-radius:10px;background:var(--surface,#fff)}.ds-model.sel{border-color:var(--accent,#0a62d0);background:var(--soft,#e3edfb);box-shadow:inset 0 0 0 1px var(--accent,#0a62d0)}.ds-pick{position:absolute;inset:0;border:0;border-radius:10px;background:transparent;cursor:pointer}.ds-pick:focus-visible{outline:2px solid var(--accent,#0a62d0);outline-offset:2px}.ds-mh,.ds-meta{position:relative;pointer-events:none}.ds-mh{display:flex;justify-content:space-between;align-items:baseline;font-size:14px}.ds-using{display:inline-flex;gap:3px;align-items:center;color:var(--accent,#0a62d0);font-size:12px;font-weight:600}.ds-meta{font-size:12px;color:var(--secondary,#5c5c61)}.ds-install{margin-top:auto;align-self:flex-start;min-height:24px;padding:3px 10px;border:1px solid var(--accent-fill,#0a62d0);border-radius:6px;background:var(--accent-fill,#0a62d0);color:#fff;font-size:12px;cursor:pointer}.ds-install:hover{filter:brightness(1.1)}"
    },
    {
      "name": "Interest Chip",
      "kind": "chip",
      "refersTo": "interest-chip",
      "description": "Explicit interests as pills (learned ones dashed) with a dashed quick-add field; a chip opens its editor popover.",
      "html": "<ul class=\"ds-chiplist\" aria-label=\"관심\"><li><button class=\"ds-ichip\">장학</button></li><li><button class=\"ds-ichip\">인공지능</button></li><li><button class=\"ds-ichip learned\">인턴십</button></li><li><input class=\"ds-add\" placeholder=\"+ 추가\" aria-label=\"관심 주제 추가\"></li></ul>",
      "css": ".ds-chiplist{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px;font:12px \"Pretendard Variable\",-apple-system,sans-serif}.ds-ichip{min-height:26px;padding:2px 11px;border:1px solid var(--line-strong,#cfcfd4);border-radius:13px;background:var(--surface,#fff);color:var(--text,#1d1d1f);font:inherit;cursor:pointer}.ds-ichip:hover,.ds-ichip:focus-visible{border-color:var(--accent,#0a62d0);color:var(--accent,#0a62d0);outline:none}.ds-ichip.learned{border-style:dashed;color:var(--text-2,#3a3a3e)}.ds-add{width:96px;min-height:26px;padding:2px 11px;border:1px dashed var(--line-strong,#cfcfd4);border-radius:13px;background:transparent;font:inherit;color:var(--text,#1d1d1f);transition:width .15s,border-color .15s}.ds-add:focus{width:160px;border-style:solid;border-color:var(--accent,#0a62d0);outline:none}"
    },
    {
      "name": "Popover",
      "kind": "custom",
      "refersTo": "popover",
      "description": "Light-dismiss explanation or detail panel anchored under its ⓘ button.",
      "html": "<div class=\"ds-pop\" role=\"dialog\" aria-label=\"학사 상태\"><p class=\"ds-pt\">학사</p><p>일부 가져옴 · 이어받기 가능</p><dl><div><dt>마지막 시도</dt><dd>11월 3일 14:20</dd></div><div><dt>마지막 성공</dt><dd>11월 3일 14:20</dd></div></dl><div class=\"ds-pa\"><button>과거 자료 이어받기</button><button>새 소식 확인</button></div></div>",
      "css": ".ds-pop{width:300px;padding:12px 14px;border:1px solid var(--line-strong,#cfcfd4);border-radius:10px;background:var(--surface,#fff);color:var(--text-2,#3a3a3e);box-shadow:0 10px 32px rgb(0 0 0/.14),0 1px 3px rgb(0 0 0/.08);font:12px/1.65 \"Pretendard Variable\",-apple-system,sans-serif}.ds-pop p{margin:0}.ds-pop p+p{margin-top:6px}.ds-pt{font-size:13px;font-weight:650;color:var(--text,#1d1d1f)}.ds-pop dl{display:grid;gap:2px;margin:8px 0 0}.ds-pop dl div{display:flex;justify-content:space-between}.ds-pop dt{color:var(--secondary,#5c5c61)}.ds-pop dd{margin:0;font-variant-numeric:tabular-nums}.ds-pa{display:flex;gap:8px;margin-top:10px}.ds-pa button{min-height:24px;padding:3px 10px;border:1px solid var(--line-strong,#cfcfd4);border-radius:6px;background:var(--surface,#fff);font:inherit;font-size:12px;cursor:pointer}.ds-pa button:hover{background:var(--hover,rgb(0 0 0/.045))}.ds-pa button:focus-visible{outline:2px solid var(--accent,#0a62d0);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "A native Mac app beside Things 3 and Fantastical",
    "overview": "The visual system is a native macOS app drawn without irony, with Things 3 and Fantastical as the craft bar (standing user decision recorded in `PRODUCT.md`). The YAML frontmatter above is the normative token list; `.impeccable/design.json` carries the matching component snippets, motion and breakpoints. The shell (sidebar, page header, banners) and Today were redesigned in this system. Settings, the reader and the AI surfaces already use the same tokens but keep their earlier geometry and have not been redesigned yet.",
    "keyCharacteristics": [
      "macOS source-list sidebar with count badges, extension groups and board scope",
      "One system-blue accent; calendar-style family colours always paired with text",
      "Pretendard at system sizes on a 13px base, tabular numerals for every count and date",
      "Flat depth: hairlines and tonal steps between bg, sidebar and pane",
      "Native-quick 140–200ms state-change motion; no decorative motion"
    ],
    "rules": [
      {
        "name": "The Title-Only Rule",
        "body": "Rows, tiles and buttons show a title, not a description. An explanation a person may need (what a switch does, a limit, a caveat) goes in the row's ⓘ button, which opens a light-dismiss popover named \"<title> 설명\". Warnings that must not be missed stay visible: errors, confirmation dialogs (unchanged wording), permission recovery steps and destructive-action consequences.",
        "section": "components"
      },
      {
        "name": "The Tabular Count Rule",
        "body": "Every count, date and time (sidebar badges, the Today subline, sync time, day numbers, meta lines) uses tabular numerals so columns and badges don't shift.",
        "section": "typography"
      },
      {
        "name": "The No-Kicker Rule",
        "body": "No eyebrows, letter-spaced kickers, header notes or taglines above or around titles. The page title stands alone; context goes in the line below it.",
        "section": "typography"
      },
      {
        "name": "The One Accent Rule",
        "body": "Blue is the only chromatic UI colour. It marks selection, focus, the unread dot, today's date and primary actions, nothing else.",
        "section": "colors"
      },
      {
        "name": "The Colour-Plus-Text Rule",
        "body": "A family colour always sits next to a text label (board name or source name). Colour identifies an institution at a glance; the text carries the meaning.",
        "section": "colors"
      },
      {
        "name": "The Fill-Versus-Text Rule",
        "body": "White text goes on `--accent-fill`, never on `--accent`. Use `--accent` only for text and icons on neutral backgrounds.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use `--accent-fill` behind white text and `--accent` for accent text and icons.",
      "Do pair every family colour with its board or source name.",
      "Do use tabular numerals for counts, dates and times.",
      "Do keep feedback chips hidden until row hover/focus, visible when pressed, and always visible at 640 px and narrower.",
      "Do give settings rows a title and one control, and put explanations in the row's ⓘ popover."
    ],
    "donts": [
      "Don't add eyebrows, letter-spaced kickers, header notes, taglines or stat tiles.",
      "Don't introduce a second chromatic accent beyond the family marks.",
      "Don't separate panes with shadows; use hairlines and tonal steps.",
      "Don't add description lines under settings rows, tiles or buttons; a second line is only for live state or a recovery step."
    ]
  }
}
