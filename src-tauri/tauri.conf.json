{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rhythm",
  "version": "0.3.0",
  "identifier": "io.github.hiyabye.rhythm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rhythm",
        "width": 1180,
        "height": 800,
        "minWidth": 640,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/rhythm-ai-worker"
    ],
    "resources": {
      "../assets/licenses/Pretendard-OFL.txt": "licenses/Pretendard-OFL.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
