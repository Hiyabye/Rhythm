{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rhythm",
  "version": "1.9.1",
  "identifier": "io.github.hiyabye.rhythm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rhythm",
        "width": 1180,
        "height": 800,
        "minWidth": 640,
        "minHeight": 540,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "../LICENSE": "licenses/Rhythm-GPL-3.0.txt",
      "../assets/licenses/Pretendard-OFL.txt": "licenses/Pretendard-OFL.txt",
      "../assets/licenses/eclass-cli-MIT.txt": "licenses/eclass-cli-MIT.txt",
      "../assets/licenses/chrono-LICENSE.txt": "licenses/chrono-LICENSE.txt",
      "../assets/licenses/encoding_rs-NOTICE.txt": "licenses/encoding_rs-NOTICE.txt",
      "../assets/licenses/native-tls-MIT.txt": "licenses/native-tls-MIT.txt",
      "../assets/licenses/hyper-tls-MIT.txt": "licenses/hyper-tls-MIT.txt",
      "../assets/licenses/tokio-native-tls-MIT.txt": "licenses/tokio-native-tls-MIT.txt",
      "../assets/licenses/mac-usernotifications-MIT.txt": "licenses/mac-usernotifications-MIT.txt",
      "../assets/licenses/mac-usernotifications-Apache-2.0.txt": "licenses/mac-usernotifications-Apache-2.0.txt",
      "binaries/llama/": "llama/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "",
      "endpoints": [
        "https://github.com/Hiyabye/Rhythm/releases/latest/download/latest.json"
      ]
    }
  }
}
